2023-10-23T12:27:28.948Z | 173.21.2.113
2023-10-23T12:15:03.360Z | 173.21.2.162
;

fieldIsMappedToKeywordSingleIndex
FROM sample_data_no_mapping
| INSIST message
| KEEP @timestamp, message
| SORT @timestamp DESC
;

@timestamp:datetime      |  message:keyword
2023-10-23T13:55:01.543Z |  Connected to 10.1.0.1
2023-10-23T13:53:55.832Z |  Connection error
2023-10-23T13:52:55.015Z |  Connection error
2023-10-23T13:51:54.732Z |  Connection error
2023-10-23T13:33:34.937Z |  42
2023-10-23T12:27:28.948Z |  Connected to 10.1.0.2
2023-10-23T12:15:03.360Z |  Connected to 10.1.0.3
;

fieldDoesNotExistSingleIndex
FROM sample_data_no_mapping
| INSIST foo
| KEEP @timestamp, foo
| SORT @timestamp DESC
;

@timestamp:date           |  foo:keyword
