;

// Tests we need:
// Single index:
// Field is not mapped and not cast
// Field is not mapped and cast
// Field does not exist
// Field is mapped to non-keyword
// Field is mapped to keyword
// Field is mapped to non-keyword and cast
// Multi index:
// Field is mapped to keyword in different indices
// Field is mapped to different types in different indices, no cast
// Field is mapped to different types in different indices, with cast, no cast  d

