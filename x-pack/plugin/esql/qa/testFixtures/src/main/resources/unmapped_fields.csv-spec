fieldIsUnmappedAndCastSingleIndex
FROM sample_data_no_mapping
| INSIST unmapped_event_duration
| EVAL unmapped_event_duration = unmapped_event_duration :: LONG
| KEEP @timestamp, event_duration, unmapped_event_duration
| SORT @timestamp DESC
;

