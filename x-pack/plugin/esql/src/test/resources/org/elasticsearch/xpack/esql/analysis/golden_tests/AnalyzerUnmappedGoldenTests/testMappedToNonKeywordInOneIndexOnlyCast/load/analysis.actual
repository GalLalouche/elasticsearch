Project[[@timestamp{f(DateEsField)}#0, client_ip{f(EsField)}#1, event_duration{f(EsField)}#2, message{f(KeywordEsField)}#3, x{r}#4]]
\_Limit[1000[INTEGER],false,false]
\_Eval[[$$event_duration$converted_to$double{f(MultiTypeEsField)$}#5 AS x#4]]
\_EsRelation[sample_data,no_mapping_sample_data][@timestamp{f}#0, client_ip{f}#1, event_duration{f}#2, message{f}#3, $$event_duration$converted_to$double{f$}#5]
